# 5 and 6. SORTING and BINARY SEARCH
# ---------------------------------------------------------------
def bubble_sort_by_name(donor_items):
    donor_items = donor_items[:]          # copy, so original is not changed
    n = len(donor_items)
    for i in range(n):
        for j in range(0, n - i - 1):
            if donor_items[j].name.lower() > donor_items[j + 1].name.lower():
                donor_items[j], donor_items[j + 1] = donor_items[j + 1], donor_items[j]
    return donor_items


def binary_search_by_name(sorted_donors, name):
    """List must already be sorted by name. Returns all matches."""
    name = name.lower()
    low = 0
    high = len(sorted_donors) - 1
    while low <= high:
        mid = (low + high) // 2
        mid_name = sorted_donors[mid].name.lower()
        if mid_name == name:
            # donors can have the same name, so check both sides
            found = [sorted_donors[mid]]
            left = mid - 1
            while left >= 0 and sorted_donors[left].name.lower() == name:
                found.append(sorted_donors[left])
                left -= 1
            right = mid + 1
            while right < len(sorted_donors) and sorted_donors[right].name.lower() == name:
                found.append(sorted_donors[right])
                right += 1
            return found
        elif mid_name < name:
            low = mid + 1
        else:
            high = mid - 1
    return []


