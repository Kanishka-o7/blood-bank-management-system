# 1. LINKED LIST for donors
# ---------------------------------------------------------------
class DonorNode:
    def __init__(self, name, age, group, phone, city):
        self.name = name
        self.age = age
        self.group = group
        self.phone = phone
        self.city = city
        self.next = None          # points to the next donor


class DonorList:
    def __init__(self):
        self.head = None

    def add(self, name, age, group, phone, city):
        new_node = DonorNode(name, age, group, phone, city)
        if self.head is None:
            self.head = new_node
            return
        current = self.head
        while current.next is not None:   # go to the last node
            current = current.next
        current.next = new_node

    def find(self, phone):
        """Return the node with this phone number (or None)."""
        current = self.head
        while current is not None:
            if current.phone == phone:
                return current
            current = current.next
        return None

    def update(self, old_phone, name, age, group, phone, city):
        node = self.find(old_phone)
        if node is None:
            return False
        if phone != old_phone and self.find(phone) is not None:
            return False                  # new phone already used
        node.name = name
        node.age = age
        node.group = group
        node.phone = phone
        node.city = city
        return True

    def delete(self, phone):
        """Delete donor using phone number (phone is unique)."""
        current = self.head
        previous = None
        while current is not None:
            if current.phone == phone:
                if previous is None:
                    self.head = current.next
                else:
                    previous.next = current.next
                return True
            previous = current
            current = current.next
        return False

    def to_list(self):
        """Convert linked list to a normal Python list."""
        result = []
        current = self.head
        while current is not None:
            result.append(current)
            current = current.next
        return result

    def search_by_group(self, group):
        """Linear search."""
        result = []
        current = self.head
        while current is not None:
            if current.group == group:
                result.append(current)
            current = current.next
        return result


