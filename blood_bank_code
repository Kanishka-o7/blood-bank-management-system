def login_screen():
    clear_window()
    ui.clear()
    root.configure(bg=DARK)

    card = tk.Frame(root, bg=WHITE, padx=45, pady=30)
    card.place(relx=0.5, rely=0.5, anchor="center")

    # blood drop logo drawn with a canvas
    drop = tk.Canvas(card, width=60, height=75, bg=WHITE, highlightthickness=0)
    drop.pack()
    drop.create_polygon(30, 4, 10, 42, 50, 42, fill=RED, outline=RED)
    drop.create_oval(8, 28, 52, 70, fill=RED, outline=RED)
    drop.create_oval(17, 44, 25, 56, fill="#ff8a80", outline="#ff8a80")

    tk.Label(card, text="Blood Bank Management System", bg=WHITE, fg=DARK,
             font=(FONT, 16, "bold")).pack(pady=(5, 0))
    tk.Label(card, text="Please login to continue", bg=WHITE, fg=GREY,
             font=(FONT, 10)).pack(pady=(0, 15))

    tk.Label(card, text="Username", bg=WHITE, fg=DARK, anchor="w",
             font=(FONT, 10)).pack(fill="x")
    user_entry = make_entry(card, 32)
    user_entry.pack(pady=(0, 10), ipady=4)

    tk.Label(card, text="Password", bg=WHITE, fg=DARK, anchor="w",
             font=(FONT, 10)).pack(fill="x")
    pass_entry = make_entry(card, 32, show="*")
    pass_entry.pack(ipady=4)

    show_var = tk.IntVar()

    def toggle_password():
        if show_var.get() == 1:
            pass_entry.config(show="")
        else:
            pass_entry.config(show="*")

    tk.Checkbutton(card, text="Show password", variable=show_var,
                   command=toggle_password, bg=WHITE, activebackground=WHITE,
                   font=(FONT, 9)).pack(anchor="w")

    attempts = {"count": 0}

    def enable_button():
        if login_btn.winfo_exists():
            login_btn.config(state="normal")

    def try_login(event=None):
        user = user_entry.get().strip()
        password = pass_entry.get()
        if user == credentials["username"] and password == credentials["password"]:
            show_main("admin")
            return
        attempts["count"] += 1
        left = 3 - attempts["count"]
        if left <= 0:
            attempts["count"] = 0
            login_btn.config(state="disabled")
            root.after(10000, enable_button)
            messagebox.showerror("Locked", "Too many wrong attempts.\n"
                                 "Login is disabled for 10 seconds.")
        else:
            messagebox.showerror("Login Failed", "Wrong username or password.\n"
                                 "Attempts left: " + str(left))

    login_btn = make_button(card, "LOGIN AS ADMIN", RED, try_login)
    login_btn.pack(fill="x", pady=(14, 6))
    make_button(card, "Continue as Visitor", DARK,
                lambda: show_main("visitor")).pack(fill="x")

    user_entry.bind("<Return>", try_login)
    pass_entry.bind("<Return>", try_login)
    user_entry.focus()


