def darker(color):
    """Make a hex colour a bit darker (used for button hover)."""
    r = int(color[1:3], 16)
    g = int(color[3:5], 16)
    b = int(color[5:7], 16)
    return "#%02x%02x%02x" % (int(r * 0.8), int(g * 0.8), int(b * 0.8))


def make_button(parent, text, color, command):
    btn = tk.Button(parent, text=text, bg=color, fg="white",
                    activebackground=darker(color), activeforeground="white",
                    font=(FONT, 10, "bold"), relief="flat", bd=0,
                    padx=14, pady=6, cursor="hand2", command=command)
    btn.bind("<Enter>", lambda e: btn.config(bg=darker(color)))
    btn.bind("<Leave>", lambda e: btn.config(bg=color))
    return btn


def make_entry(parent, width, show=""):
    return tk.Entry(parent, width=width, font=(FONT, 10), relief="solid",
                    bd=1, show=show)


def make_label(parent, text, bg=WHITE):
    return tk.Label(parent, text=text, bg=bg, fg=DARK, font=(FONT, 10))


def make_card(parent, title):
    """White box with a heading, used for forms."""
    box = tk.Frame(parent, bg=WHITE, highlightbackground="#dddddd",
                   highlightthickness=1)
    tk.Label(box, text=title, bg=WHITE, fg=RED,
             font=(FONT, 11, "bold")).pack(anchor="w", padx=12, pady=(8, 0))
    inner = tk.Frame(box, bg=WHITE)
    inner.pack(fill="x", padx=12, pady=8)
    return box, inner


def make_table(parent, columns, widths, height=10):
    frame = tk.Frame(parent, bg=LIGHT)
    table = ttk.Treeview(frame, columns=columns, show="headings", height=height)
    scroll = ttk.Scrollbar(frame, orient="vertical", command=table.yview)
    table.configure(yscrollcommand=scroll.set)
    for col, w in zip(columns, widths):
        table.heading(col, text=col)
        table.column(col, width=w, anchor="center")
    table.pack(side="left", fill="both", expand=True)
    scroll.pack(side="right", fill="y")
    return frame, table


