# BLOOD REQUESTS PAGE (admin only)
# ---------------------------------------------------------------
def refresh_requests():
    if "request_table" not in ui:
        return
    table = ui["request_table"]
    for row in table.get_children():
        table.delete(row)
    position = 0
    for r in requests:
        table.insert("", "end", iid=str(position),
                     values=(position + 1, r[0], r[1], r[2]))
        position += 1


def build_requests_page(parent):
    page = tk.Frame(parent, bg=LIGHT)

    box, form = make_card(page, "New Blood Request  (served first-come-first-served)")
    box.pack(fill="x", pady=(0, 10))

    make_label(form, "Patient Name").grid(row=0, column=0, padx=(0, 5))
    patient_entry = make_entry(form, 18)
    patient_entry.grid(row=0, column=1, ipady=3)
    make_label(form, "Blood Group").grid(row=0, column=2, padx=(15, 5))
    group_box = ttk.Combobox(form, values=BLOOD_GROUPS, width=5,
                             state="readonly", font=(FONT, 10))
    group_box.grid(row=0, column=3)
    group_box.current(0)
    make_label(form, "Units").grid(row=0, column=4, padx=(15, 5))
    units_entry = make_entry(form, 6)
    units_entry.grid(row=0, column=5, ipady=3)

    def add_request():
        patient = patient_entry.get().strip()
        units = units_entry.get().strip()
        if patient == "" or not units.isdigit() or int(units) <= 0:
            messagebox.showerror("Error", "Enter patient name and valid units")
            return
        requests.append((patient, group_box.get(), int(units)))     # enqueue
        patient_entry.delete(0, tk.END)
        units_entry.delete(0, tk.END)
        refresh_requests()
        refresh_dashboard()

    make_button(form, "Add Request", GREEN, add_request).grid(row=0, column=6, padx=(20, 0))

    bottom = tk.Frame(page, bg=LIGHT)
    bottom.pack(side="bottom", fill="x", pady=(8, 0))

    table_frame, request_table = make_table(
        page, ("Position", "Patient", "Blood Group", "Units"),
        (100, 220, 130, 100), height=8)
    table_frame.pack(fill="both", expand=True)
    ui["request_table"] = request_table

    def process_request():
        if len(requests) == 0:
            messagebox.showinfo("Queue", "No pending requests")
            return
        patient, group, units = requests[0]            # front of the queue
        if stock[group] >= units:
            requests.popleft()                         # dequeue
            stock[group] -= units
            undo_stack.append((group, -units, "Issued " + str(units) +
                               " unit(s) of " + group + " to " + patient))
            refresh_requests()
            refresh_stock()
            refresh_dashboard()
            messagebox.showinfo("Done", "Request of " + patient + " completed")
        else:
            messagebox.showwarning("Not enough blood",
                                   "Only " + str(stock[group]) + " unit(s) of " +
                                   group + " available.\nThe request stays in the queue.")

    def cancel_request():
        selected = request_table.selection()
        if not selected:
            messagebox.showwarning("Select", "Click a request in the table first")
            return
        if messagebox.askyesno("Cancel", "Cancel the selected request?"):
            del requests[int(selected[0])]
            refresh_requests()
            refresh_dashboard()

    make_button(bottom, "Process Next Request", BLUE, process_request).pack(side="left")
    make_button(bottom, "Cancel Selected", RED, cancel_request).pack(side="right")
    return page


