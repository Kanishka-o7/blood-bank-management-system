def check_donor_fields(name, age, phone, city):
    """Returns an error message, or None if everything is fine."""
    if name == "" or age == "" or phone == "" or city == "":
        return "Please fill all the fields"
    if not age.isdigit() or not (18 <= int(age) <= 65):
        return "Donor age must be between 18 and 65"
    if not phone.isdigit() or len(phone) != 10:
        return "Phone number must be 10 digits"
    return None


def show_donors(donor_items):
    """Show a list of donors in the table."""
    if "donor_table" not in ui:
        return
    table = ui["donor_table"]
    for row in table.get_children():
        table.delete(row)
    for d in donor_items:
        table.insert("", "end", iid=d.phone,
                     values=(d.name, d.age, d.group, d.phone, d.city))
    ui["donor_count"].config(text="Donors shown: " + str(len(donor_items)))


def build_donors_page(parent, is_admin):
    page = tk.Frame(parent, bg=LIGHT)

    # ----- search box (everyone can use it) -----
    search_box, search_inner = make_card(page, "Search Donors")
    search_box.pack(fill="x", pady=(0, 10))

    make_label(search_inner, "Name").grid(row=0, column=0, padx=(0, 5))
    search_name = make_entry(search_inner, 18)
    search_name.grid(row=0, column=1, ipady=3)
    make_label(search_inner, "Blood Group").grid(row=0, column=3, padx=(15, 5))
    search_group = ttk.Combobox(search_inner, values=BLOOD_GROUPS, width=5,
                                state="readonly", font=(FONT, 10))
    search_group.grid(row=0, column=4)
    search_group.current(0)

    def search_by_name():
        name = search_name.get().strip()
        if name == "":
            messagebox.showerror("Error", "Enter a name to search")
            return
        sorted_list = bubble_sort_by_name(donors.to_list())   # sort first
        result = binary_search_by_name(sorted_list, name)     # then binary search
        show_donors(result)
        if len(result) == 0:
            messagebox.showinfo("Result", "No donor found with this name")

    def search_by_group():
        result = donors.search_by_group(search_group.get())
        show_donors(result)
        if len(result) == 0:
            messagebox.showinfo("Result", "No donor found with this blood group")

    make_button(search_inner, "Search Name", BLUE,
                search_by_name).grid(row=0, column=2, padx=8)
    make_button(search_inner, "Search Group", BLUE,
                search_by_group).grid(row=0, column=5, padx=8)
    make_button(search_inner, "Sort by Name", GREY,
                lambda: show_donors(bubble_sort_by_name(donors.to_list()))
                ).grid(row=0, column=6, padx=4)
    make_button(search_inner, "Show All", GREY,
                lambda: show_donors(donors.to_list())).grid(row=0, column=7, padx=4)

    # ----- add / edit form (admin only) -----
    if is_admin:
        form_box, form = make_card(page, "Add / Edit Donor  (click a row in the table to edit it)")
        form_box.pack(fill="x", pady=(0, 10))

        make_label(form, "Name").grid(row=0, column=0, padx=(0, 5), pady=4)
        name_entry = make_entry(form, 18)
        name_entry.grid(row=0, column=1, ipady=3)
        make_label(form, "Age").grid(row=0, column=2, padx=(15, 5))
        age_entry = make_entry(form, 6)
        age_entry.grid(row=0, column=3, ipady=3)
        make_label(form, "Blood Group").grid(row=0, column=4, padx=(15, 5))
        group_box = ttk.Combobox(form, values=BLOOD_GROUPS, width=5,
                                 state="readonly", font=(FONT, 10))
        group_box.grid(row=0, column=5)
        group_box.current(0)

        make_label(form, "Phone").grid(row=1, column=0, padx=(0, 5), pady=4)
        phone_entry = make_entry(form, 18)
        phone_entry.grid(row=1, column=1, ipady=3)
        make_label(form, "City").grid(row=1, column=2, padx=(15, 5))
        city_entry = make_entry(form, 15)
        city_entry.grid(row=1, column=3, columnspan=2, sticky="w", ipady=3)

        ui["editing"] = None          # phone of the donor being edited

        def clear_form():
            for box in (name_entry, age_entry, phone_entry, city_entry):
                box.delete(0, tk.END)
            group_box.current(0)
            ui["editing"] = None

        def add_donor():
            name = name_entry.get().strip()
            age = age_entry.get().strip()
            phone = phone_entry.get().strip()
            city = city_entry.get().strip()
            error = check_donor_fields(name, age, phone, city)
            if error:
                messagebox.showerror("Error", error)
                return
            if donors.find(phone) is not None:
                messagebox.showerror("Error", "A donor with this phone already exists")
                return
            donors.add(name, int(age), group_box.get(), phone, city)
            show_donors(donors.to_list())
            refresh_dashboard()
            clear_form()
            messagebox.showinfo("Done", "Donor added successfully")

        def update_donor():
            old_phone = ui["editing"]
            if old_phone is None:
                messagebox.showwarning("Select", "Click a donor in the table first")
                return
            name = name_entry.get().strip()
            age = age_entry.get().strip()
            phone = phone_entry.get().strip()
            city = city_entry.get().strip()
            error = check_donor_fields(name, age, phone, city)
            if error:
                messagebox.showerror("Error", error)
                return
            if donors.update(old_phone, name, int(age), group_box.get(), phone, city):
                show_donors(donors.to_list())
                clear_form()
                messagebox.showinfo("Done", "Donor updated successfully")
            else:
                messagebox.showerror("Error", "This phone number is already used")

        def delete_donor():
            selected = donor_table.selection()
            if not selected:
                messagebox.showwarning("Select", "Click a donor in the table first")
                return
            if messagebox.askyesno("Delete", "Delete the selected donor?"):
                donors.delete(selected[0])
                show_donors(donors.to_list())
                refresh_dashboard()
                clear_form()

        def on_select(event):
            selected = donor_table.selection()
            if not selected:
                return
            node = donors.find(selected[0])
            if node is None:
                return
            clear_form()
            name_entry.insert(0, node.name)
            age_entry.insert(0, node.age)
            phone_entry.insert(0, node.phone)
            city_entry.insert(0, node.city)
            group_box.set(node.group)
            ui["editing"] = node.phone

        buttons = tk.Frame(form, bg=WHITE)
        buttons.grid(row=0, column=6, rowspan=2, padx=(20, 0))
        make_button(buttons, "Add Donor", GREEN, add_donor).pack(fill="x", pady=2)
        make_button(buttons, "Update Donor", BLUE, update_donor).pack(fill="x", pady=2)
        make_button(buttons, "Clear", GREY, clear_form).pack(fill="x", pady=2)

