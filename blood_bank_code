# BLOOD STOCK PAGE
# ---------------------------------------------------------------
def refresh_stock():
    if "stock_table" not in ui:
        return
    table = ui["stock_table"]
    for row in table.get_children():
        table.delete(row)
    for group in BLOOD_GROUPS:
        units = stock[group]
        if units == 0:
            status = "Out of stock"
            tag = "empty"
        elif units < 5:
            status = "Low"
            tag = "low"
        else:
            status = "Available"
            tag = "good"
        table.insert("", "end", values=(group, units, status), tags=(tag,))

    if "history_box" in ui:
        ui["history_box"].delete(0, tk.END)
        for item in reversed(undo_stack):          # top of stack first
            ui["history_box"].insert(tk.END, "  " + item[2])


def build_stock_page(parent, is_admin):
    page = tk.Frame(parent, bg=LIGHT)

    table_frame, stock_table = make_table(
        page, ("Blood Group", "Units Available", "Status"),
        (200, 200, 200), height=8)
    table_frame.pack(fill="x")
    stock_table.tag_configure("good", foreground=GREEN)
    stock_table.tag_configure("low", foreground=ORANGE)
    stock_table.tag_configure("empty", foreground=RED)
    ui["stock_table"] = stock_table

    if not is_admin:
        return page

    box, form = make_card(page, "Add / Issue Blood")
    box.pack(fill="x", pady=10)

    make_label(form, "Blood Group").grid(row=0, column=0, padx=(0, 5))
    group_box = ttk.Combobox(form, values=BLOOD_GROUPS, width=5,
                             state="readonly", font=(FONT, 10))
    group_box.grid(row=0, column=1)
    group_box.current(0)
    make_label(form, "Units").grid(row=0, column=2, padx=(15, 5))
    units_entry = make_entry(form, 8)
    units_entry.grid(row=0, column=3, ipady=3)

    def get_units():
        text = units_entry.get().strip()
        if not text.isdigit() or int(text) <= 0:
            messagebox.showerror("Error", "Enter a valid number of units")
            return None
        return int(text)

    def after_stock_change():
        units_entry.delete(0, tk.END)
        refresh_stock()
        refresh_dashboard()

    def add_units():
        units = get_units()
        if units is None:
            return
        group = group_box.get()
        stock[group] += units
        undo_stack.append((group, units, "Added " + str(units) + " unit(s) of " + group))   # push
        after_stock_change()

    def issue_units():
        units = get_units()
        if units is None:
            return
        group = group_box.get()
        if stock[group] < units:
            messagebox.showerror("Error", "Only " + str(stock[group]) +
                                 " unit(s) of " + group + " available")
            return
        stock[group] -= units
        undo_stack.append((group, -units, "Issued " + str(units) + " unit(s) of " + group))  # push
        after_stock_change()

    def undo_last():
        if len(undo_stack) == 0:
            messagebox.showinfo("Undo", "Nothing to undo")
            return
        group, change, text = undo_stack.pop()        # pop from stack
        if stock[group] - change < 0:
            messagebox.showerror("Error", "Cannot undo, stock would become negative")
            undo_stack.append((group, change, text))
            return
        stock[group] -= change                        # reverse the action
        after_stock_change()

    make_button(form, "Add Units", GREEN, add_units).grid(row=0, column=4, padx=(20, 5))
    make_button(form, "Issue Units", BLUE, issue_units).grid(row=0, column=5, padx=5)
    make_button(form, "Undo Last", ORANGE, undo_last).grid(row=0, column=6, padx=5)

    tk.Label(page, text="Recent Activity  (Stack - latest on top)", bg=LIGHT,
             fg=DARK, font=(FONT, 10, "bold")).pack(anchor="w")
    ui["history_box"] = tk.Listbox(page, height=6, font=(FONT, 10), bd=1,
                                   relief="solid", highlightthickness=0)
    ui["history_box"].pack(fill="x", pady=(3, 0))
    return page


