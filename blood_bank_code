def build_settings_page(parent):
    page = tk.Frame(parent, bg=LIGHT)

    box, form = make_card(page, "Change Admin Password")
    box.pack(anchor="nw", pady=5)

    make_label(form, "Old Password").grid(row=0, column=0, sticky="w", pady=6)
    old_entry = make_entry(form, 25, show="*")
    old_entry.grid(row=0, column=1, padx=10, ipady=3)
    make_label(form, "New Password").grid(row=1, column=0, sticky="w", pady=6)
    new_entry = make_entry(form, 25, show="*")
    new_entry.grid(row=1, column=1, padx=10, ipady=3)
    make_label(form, "Confirm Password").grid(row=2, column=0, sticky="w", pady=6)
    confirm_entry = make_entry(form, 25, show="*")
    confirm_entry.grid(row=2, column=1, padx=10, ipady=3)

    def change_password():
        if old_entry.get() != credentials["password"]:
            messagebox.showerror("Error", "Old password is wrong")
        elif len(new_entry.get()) < 4:
            messagebox.showerror("Error", "New password must have at least 4 characters")
        elif new_entry.get() != confirm_entry.get():
            messagebox.showerror("Error", "New password and confirm password do not match")
        else:
            credentials["password"] = new_entry.get()
            for e in (old_entry, new_entry, confirm_entry):
                e.delete(0, tk.END)
            messagebox.showinfo("Done", "Password changed successfully")

    make_button(form, "Change Password", RED, change_password).grid(
        row=3, column=1, sticky="w", padx=10, pady=10)
    return page


