    cards = tk.Frame(page, bg=LIGHT)
    cards.pack(fill="x")
    ui["cards"] = {}
    card_info = [("donors", "Total Donors", RED),
                 ("units", "Units in Stock", GREEN),
                 ("requests", "Pending Requests", BLUE),
                 ("low", "Low Stock Groups", ORANGE)]
    for key, text, color in card_info:
        card = tk.Frame(cards, bg=WHITE, highlightbackground="#dddddd",
                        highlightthickness=1)
        card.pack(side="left", expand=True, fill="x", padx=6)
        tk.Frame(card, bg=color, height=5).pack(fill="x")
        value = tk.Label(card, text="0", bg=WHITE, fg=color,
                         font=(FONT, 26, "bold"))
        value.pack(pady=(10, 0))
        tk.Label(card, text=text, bg=WHITE, fg=GREY,
                 font=(FONT, 10)).pack(pady=(0, 10))
        ui["cards"][key] = value

    chart_box = tk.Frame(page, bg=WHITE, highlightbackground="#dddddd",
                         highlightthickness=1)
    chart_box.pack(fill="both", expand=True, padx=6, pady=(15, 0))
    tk.Label(chart_box, text="Blood Stock Overview", bg=WHITE, fg=DARK,
             font=(FONT, 12, "bold")).pack(anchor="w", padx=15, pady=(10, 0))
    ui["chart"] = tk.Canvas(chart_box, width=780, height=270, bg=WHITE,
                            highlightthickness=0)
    ui["chart"].pack(pady=5)
    return page


def refresh_dashboard():
    if "cards" not in ui:
        return
    total_units = 0
    low_groups = 0
    for group in BLOOD_GROUPS:
        total_units += stock[group]
        if stock[group] < 5:
            low_groups += 1

    ui["cards"]["donors"].config(text=str(len(donors.to_list())))
    ui["cards"]["units"].config(text=str(total_units))
    ui["cards"]["requests"].config(text=str(len(requests)))
    ui["cards"]["low"].config(text=str(low_groups))

    # ----- bar chart of the stock -----
    canvas = ui["chart"]
    canvas.delete("all")
    biggest = max(max(stock.values()), 10)
    canvas.create_line(30, 225, 760, 225, fill="#999999")
    for i in range(len(BLOOD_GROUPS)):
        group = BLOOD_GROUPS[i]
        units = stock[group]
        x = 55 + i * 88
        bar_height = int(units / biggest * 170)
        if units == 0:
            color = "#bdbdbd"
        elif units < 5:
            color = ORANGE
        else:
            color = RED
        canvas.create_rectangle(x, 225 - bar_height, x + 50, 225,
                                fill=color, outline=color)
        canvas.create_text(x + 25, 215 - bar_height, text=str(units),
                           font=(FONT, 10, "bold"), fill=DARK)
        canvas.create_text(x + 25, 245, text=group, font=(FONT, 10),
                           fill=DARK)

    # small legend
    canvas.create_rectangle(560, 8, 572, 20, fill=RED, outline=RED)
    canvas.create_text(578, 14, text="Good", anchor="w", font=(FONT, 9))
    canvas.create_rectangle(625, 8, 637, 20, fill=ORANGE, outline=ORANGE)
    canvas.create_text(643, 14, text="Low (<5)", anchor="w", font=(FONT, 9))
    canvas.create_rectangle(705, 8, 717, 20, fill="#bdbdbd", outline="#bdbdbd")
    canvas.create_text(723, 14, text="Empty", anchor="w", font=(FONT, 9))


